# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public demo mode: throwaway sample workspaces, risky features disabled.
LEROA_DEMO=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Protects /api/cron (daily rent posting, late fees and reminders).
CRON_SECRET=

# Online rent payments (optional). Webhook endpoint: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=
MOLLIE_API_KEY=
BILT_CLIENT_ID=
BILT_CLIENT_SECRET=
BILT_WEBHOOK_SECRET=
BILT_ENVIRONMENT=

# QuickBooks Online: an Intuit developer app (https://developer.intuit.com). Register
# <ORIGIN>/api/integrations/quickbooks/callback as its redirect URI.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# production (default) or sandbox
QBO_ENVIRONMENT=

# Xero: a Xero web app (https://developer.xero.com/app/manage). Register
# <ORIGIN>/api/integrations/xero/callback as its redirect URI.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Social sign-in (each provider shows up once its keys are set). Redirect URIs:
# <ORIGIN>/api/auth/callback/google, /facebook and /twitter (X).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Leroa Profile: a resident profile shared, with consent, across installs.
# Point at a profile service, e.g. https://id.leroa.com, to offer "Fill from my Leroa profile",
# the portal's Connect button, and "Continue with Leroa" unified sign-in.
LEROA_PROFILE_URL=
# Set to true to run this install as a profile service itself.
LEROA_PROFILE_HUB=

# AI features (BYOK, optional; no enterprise license required). Any OpenAI-compatible chat-completions
# endpoint works; unset, every AI feature uses deterministic local fallbacks.
# Generative features (assistant, drafting, summaries, classification) use:
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional: route the structured snap decisions (maintenance intake, lead
# scoring, message triage, delinquency watch) to a different key/model, e.g. a
# cheaper, faster one. Each falls back to its AI_* counterpart when unset, so a
# single-key install needs none of these.
AI_DECISION_API_KEY=
AI_DECISION_BASE_URL=
AI_DECISION_MODEL=
