# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public demo mode: throwaway sample workspaces, risky features disabled.
LEROA_DEMO=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Protects /api/cron (daily rent posting, late fees and reminders).
CRON_SECRET=

# Online rent payments (optional). Webhook endpoint: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=
MOLLIE_API_KEY=
BILT_CLIENT_ID=
BILT_CLIENT_SECRET=
BILT_WEBHOOK_SECRET=
BILT_ENVIRONMENT=

# QuickBooks Online: an Intuit developer app (https://developer.intuit.com). Register
# <ORIGIN>/api/integrations/quickbooks/callback as its redirect URI.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# production (default) or sandbox
QBO_ENVIRONMENT=
