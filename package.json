{
	"name": "leroa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"start": "node scripts/migrate.ts && PROTOCOL_HEADER=x-forwarded-proto node scripts/server.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.51.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"auth": "^1.6.24",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"layerchart": "^2.5.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.7",
		"@better-auth/passkey": "^1.7.7",
		"@better-auth/sso": "^1.7.7",
		"@leroa/integration-sdk": "workspace:*",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"better-auth": "^1.6.24",
		"drizzle-orm": "^0.45.2",
		"nodemailer": "^9.1.1",
		"postgres": "^3.4.9",
		"valibot": "^1.5.0"
	}
}
